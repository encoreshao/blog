---
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import HeroSection from '../../components/HeroSection.astro';
import ProjectsStrip from '../../components/ProjectsStrip.astro';
import TimelineFeed from '../../components/TimelineFeed.astro';
import TagFilter from '../../components/TagFilter.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('en', ({ data }) => !data.draft)
  .then(list => list.sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()));
const allTags = [...new Set(posts.flatMap(p => p.data.tags))].sort();

const site = 'https://blog.icmoc.com';
const description = 'Writing by Encore Shao — Full-stack Engineer & AI Researcher. Essays on Rails/Ruby engineering, agentic AI systems, MCP servers, and lessons from shipping production software.';

const personJsonLd = {
  '@type': 'Person',
  name: 'Encore Shao',
  url: 'https://icmoc.com',
  jobTitle: 'Full-stack Engineer & AI Researcher',
  worksFor: { '@type': 'Organization', name: 'Ekohe' },
  sameAs: ['https://github.com/encoreshao', 'https://icmoc.com'],
};

const websiteJsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: "Encore Shao's Blog",
  url: `${site}/en/`,
  description,
  inLanguage: 'en',
  author: personJsonLd,
  publisher: personJsonLd,
});

const blogJsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Blog',
  name: "Encore Shao's Blog",
  url: `${site}/en/`,
  inLanguage: 'en',
  author: personJsonLd,
  blogPost: posts.map(post => ({
    '@type': 'BlogPosting',
    headline: post.data.title,
    url: `${site}/en/${post.id.replace(/\.md$/, '')}/`,
    datePublished: post.data.date.toISOString(),
    description: post.data.excerpt,
    keywords: post.data.tags.join(', '),
  })),
});
---

<Base
  title="Writing"
  lang="en"
  description={description}
  alternateHref={`${site}/zh/`}
>
  <script slot="head" type="application/ld+json" set:html={websiteJsonLd} />
  <script slot="head" type="application/ld+json" set:html={blogJsonLd} />
  <Nav lang="en" currentPath="/en/" />
  <main>
    <HeroSection lang="en" postCount={posts.length} />
    <ProjectsStrip lang="en" />
    <div class="feed-header">
      <h2 class="feed-title">Writing</h2>
      <span class="feed-sub">Thoughts on engineering, AI, and shipping software</span>
    </div>
    <TagFilter tags={allTags} lang="en" />
    <TimelineFeed posts={posts} lang="en" />
  </main>
  <footer>
    © 2026 Encore Shao · Shanghai ·
    <a href="https://github.com/encoreshao" target="_blank" rel="noopener">GitHub</a> ·
    <a href="https://icmoc.com" target="_blank" rel="noopener">icmoc.com</a>
  </footer>
</Base>

<style>
  main {
    max-width: 1200px;
    margin: 0 auto;
    padding: 56px 40px;
    position: relative;
    z-index: 1;
  }
  @media (max-width: 640px) {
    main { padding: 28px 16px; }
  }
  .feed-header {
    display: flex; align-items: baseline; gap: 12px;
    margin-bottom: 20px;
  }
  .feed-title {
    font-size: 13px; font-weight: 700; color: rgba(var(--fg-rgb),0.5);
    letter-spacing: 2px; text-transform: uppercase;
  }
  .feed-sub { font-size: 12px; color: rgba(var(--fg-rgb),0.2); }
  footer {
    text-align: center; padding: 40px 24px;
    font-size: 12px; color: rgba(var(--fg-rgb),0.2);
    border-top: 1px solid rgba(var(--fg-rgb),0.06);
    position: relative; z-index: 1;
  }
  footer a { color: var(--cyan); text-decoration: none; }
</style>
